# ==========================================
# Google Cloud Platform (GCP) & Cloud Run
# ==========================================
# Project ID in Google Cloud Console
GCP_PROJECT_ID="your-gcp-project-id"

# Region for Artifact Registry and Cloud Run service (e.g. asia-southeast1, us-central1)
GCP_REGION="asia-southeast1"

# Service name in Google Cloud Run
GCP_SERVICE_NAME="examkart-app"

# Repository name in Artifact Registry
GCP_REPOSITORY="app-repo"

# ==========================================
# Application & Gemini AI Secrets
# ==========================================
# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="your-gemini-api-key"

# APP_URL: The public URL of the deployed application.
APP_URL="https://examkart-app-xyz.a.run.app"

